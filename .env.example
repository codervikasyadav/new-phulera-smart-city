# ========================================================
# RESEND EMAIL CONFIGURATION FOR VERCEL & LOCAL DEV
# ========================================================
# Add these variables directly in your Vercel Project Settings:
# Settings -> Environment Variables

# 1. Resend API Key (Create at https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Sender Email Address:
# - For testing before domain verification: 'New Phulera Smart City <onboarding@resend.dev>'
# - After verifying your custom domain in Resend: 'New Phulera Smart City <enquiry@newphulerasmartcity.in>'
RESEND_FROM_EMAIL=New Phulera Smart City <onboarding@resend.dev>

# 3. Notification Recipient Email:
# Email address where all enquiry submissions will be forwarded
NOTIFICATION_EMAIL=enquiry@newphulerasmartcity.in
